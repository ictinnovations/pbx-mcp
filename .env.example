# pbx-mcp configuration.
# Copy to .env for local testing, or set these in your MCP client config.
# By Tahir Almas, ICT Innovations (https://ictinnovations.com)

# --- Asterisk (omit the host to disable all Asterisk tools) ---
ASTERISK_AMI_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=mcp
ASTERISK_AMI_PASSWORD=change-me
ASTERISK_AMI_TLS=false

# --- FreeSWITCH (omit the host to disable all FreeSWITCH tools) ---
FREESWITCH_ESL_HOST=127.0.0.1
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD=ClueCon

# --- Shared ---
# Leave write disabled unless you want the assistant placing and dropping calls.
PBX_MCP_ALLOW_WRITE=false
PBX_MCP_TIMEOUT_MS=10000

# --- Provisioning (Asterisk, opt-in; see the README) ---
PBX_MCP_ALLOW_PROVISION=false
# Fail closed: leave these unset and creates are refused. Uncomment and edit to allow.
# PBX_MCP_TRUNK_ALLOW=192.0.2.0/24
# PBX_MCP_CONTEXT_ALLOW=from-internal
PBX_MCP_PJSIP_FILE=pjsip_mcp.conf
